{
  "$comment-1": "Per-project configuration for the flow plugin. Every slot is OPTIONAL — flow ships sensible defaults. Slots you DON'T set use the documented default. Schema: https://github.com/by-dev-tools/flow/blob/main/plugins/flow/schema/flow.config.schema.json",
  "$comment-2": "DELETE THIS BLOCK AND THE $comment-* lines BEFORE COMMITTING. They are not part of the schema; they're here for the bootstrap reader.",

  "defaultBranch": "main",

  "$comment-typecheckCmd": "Shell command to run as the project's typecheck (after review fixes land). Run via sh -c, not eval. UNSET → /flow:ship prints a loud ⚠️ warning rather than silently skipping.",
  "typecheckCmd": "npm run typecheck",

  "$comment-preflightCmd": "Shell command for the project's mechanical preflight (typecheck + lint + fast tests; project owns the composition). Run via sh -c at /flow:ship Step 1c + /flow:ship-spike Step 1c with bounded fix-and-retry (N≤3). UNSET → loud ⚠️ warning, pipeline proceeds. Typical convention: node tools/preflight/check.mjs.",
  "preflightCmd": "node tools/preflight/check.mjs",

  "$comment-paths": "Doc paths used by /flow:ship for synthesis and by the reviewers for grounding. Defaults below are the consumer convention (core-docs/). Flow's own repo overrides to dev-docs/.",
  "historyPath": "core-docs/history.md",
  "planPath": "core-docs/plan.md",
  "roadmapPath": "core-docs/roadmap.md",
  "specPath": "core-docs/spec.md",
  "feedbackPath": "core-docs/feedback.md",
  "designLanguagePath": "core-docs/design-language.md",

  "$comment-statusDocs": "Extra forward-looking status surfaces /flow:ship reconciles every ship beyond plan 'Current Focus' + roadmap 'Now' — e.g. a CLAUDE.md / README status line a cold agent reads. Each entry: {path, marker}. Flow edits ONLY the region between <!-- {marker} --> and <!-- /{marker} --> (a narrow, mechanical update — fence the status region in the file first). Step 5b BLOCKS a ship that moved plan/roadmap status forward but left a declared region untouched (works with NO version manifest); /flow:doctor Check 2.7 checks each is fenced. Seeded with CLAUDE.md (the scaffolded CLAUDE.md ships with a <!-- flow:status --> fence) so you get Tier 2 auto-reconcile by default — add README.md etc. as you fence them. Empty [] opts out (Step 5a.5 still nags on undeclared drift).",
  "statusDocs": [{ "path": "CLAUDE.md", "marker": "flow:status" }],

  "$comment-statusSurfaceCandidates": "OPT-IN OVERRIDE (default applies if omitted). Well-known auto-loading orientation docs /flow:ship Step 5a.5 + /flow:doctor scan to DISCOVER surfaces that drifted but were never declared in statusDocs. Default covers CLAUDE.md, AGENTS.md, README.md, GEMINI.md, .cursorrules, .github/copilot-instructions.md. Step 5a.5 (only when this ship moved plan/roadmap status) best-effort-judges each undeclared candidate for a stale 'next/not-started' claim and routes a flagged one to the draft manifest — never a hard halt, never a silent edit. Override to extend/narrow, or set [] to disable discovery. Shown here so you know it exists; leave unset for the default.",

  "$comment-referenceGlob": "Glob /flow:critique-plan uses to load reference docs. Excludes history/plan/roadmap automatically (those churn too often to be reliable spec sources).",
  "referenceGlob": "core-docs/*.md",

  "$comment-uiSurface": "Whether this project ships a UI. If false, /flow:accessibility-review exits early instead of running an empty audit. Backend / CLI / library projects: set to false.",
  "uiSurface": true,

  "$comment-diff-patterns": "Extended-regex (grep -E) patterns for per-diff early-exit. sourceFilePatterns: /flow:security-review skips a diff with no source files (docs-only PR). uiFilePatterns: the SHARED UI pattern — both /flow:accessibility-review and /flow:verify-build's visual-significance predicate fall back to it. All ship sensible cross-language defaults in the schema — set ONLY to override for an unusual project. Shown here so you know they exist.",
  "sourceFilePatterns": "\\.(ts|tsx|js|jsx|mjs|cjs|py|rs|swift|go|rb|java|kt|sh|bash|tf|tfvars|sql|proto|graphql|gql)$|\\.(json|ya?ml|toml)$|(^|/)(Dockerfile|Makefile)(\\.|$)",
  "uiFilePatterns": "\\.(tsx|jsx|vue|svelte|astro|mdx|css|scss|sass|less|html|njk|hbs|ejs)$",

  "$comment-split-ui-patterns": "OPTIONAL per-consumer overrides (FB-0079). uiFilePatterns above gates two reviewers that ask DIFFERENT questions: visual-significance asks 'does this change what the app DRAWS?', accessibility-review asks 'does this change something with an ACCESSIBILITY SURFACE?'. Those sets are not the same set, so one pattern can force you to mis-scope one reviewer to serve the other. Set either slot below to scope that reviewer independently; each resolves <own slot> -> uiFilePatterns -> built-in default, so leaving both unset is exactly the pre-split behavior. Worked example (iOS/SwiftUI): a store that builds the string VoiceOver reads belongs in a11yFilePatterns but not visualFilePatterns; a mock-data file that decides a chart's shape is the reverse. Both are shown below as $comment-example- keys (bootstrap.sh strips every $comment* key, so they never land in a generated config). Drop the $comment-example- prefix to activate one.",
  "$comment-example-visualFilePatterns": "(^|/)(App|Views|DesignSystem|Charts)/.*\\.swift$",
  "$comment-example-a11yFilePatterns": "(^|/)(App|Views|DesignSystem|Insight)/.*\\.swift$",

  "$comment-reviewLenses": "Which /flow:staff-review lenses spawn in parallel. Removing a lens means it won't run — document why in your plan doc.",
  "reviewLenses": ["staff-engineer", "ux-designer", "design-engineer", "push-further"],

  "$comment-memoryHardCap": "Max failure-pattern memory entries before tools/memory/check.mjs forces curation. Most projects need < 30 if the source-diversity bar is honored.",
  "memoryHardCap": 30,

  "$comment-branchPrefix": "Conventional prefix for feature branches created by /flow:ship and /flow:ship-spike. Common: 'claude/', 'feature/', 'fix/'. Empty disables.",
  "branchPrefix": "claude/",

  "$comment-verify-build": "Controls /flow:verify-build, the runtime behavioral-verification gate at /flow:ship Step 2 (v1.3.0). platform: hint for skip-path decisions — 'library'/'none' self-skips (no runnable target); ios additionally self-skips on a host missing the whole Apple toolchain (verifiable in principle, not here — the skip is validated by /flow:audit-skips and still drafts the PR); web/android/tauri/cli run the verify pass; UNSET → bundled /run autodetects. verifyEnabled: project-wide on/off. verifyBudgetCalls: tool-call cap before unjudged verdicts are forced to Unknown (which gates ship). NOTE: requires a /run launch recipe — run /run-skill-generator once per project (doctor Check 5.3 surfaces the gap).",
  "platform": "web",
  "verifyEnabled": true,
  "verifyFindingsPath": ".flow/verify-findings.json",
  "verifyBudgetCalls": 60,

  "$comment-rustWorkspaceDir": "(Tauri / Rust stacks only — omit on pure web / swift / non-Rust projects.) Directory holding your Cargo workspace. Default 'src-tauri' is the Tauri convention; non-Tauri Rust projects set '.' (workspace at root) or the subdir name.",
  "rustWorkspaceDir": "src-tauri"
}
